# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Service-role key (SECRET, server-only) — lets the admin dashboard read/manage
# leads. Supabase → Project Settings → API → "service_role". Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin Dashboard Password
ADMIN_PASSWORD=your_secure_admin_password

# Public site URL (used to build lead-detail links in notifications).
# Optional — falls back to the request origin if unset.
NEXT_PUBLIC_SITE_URL=https://cash4shirts.com

# Lead notifications — Twilio (SMS to Jake + auto-SMS to seller)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890        # Jake's real Twilio number (sellers can reply)
JAKE_NOTIFICATION_PHONE=+1234567890   # where new-lead alerts are texted

# Lead notifications — Resend (full submission + photos emailed to Jake)
RESEND_API_KEY=your_resend_api_key
JAKE_NOTIFICATION_EMAIL=jake@cash4shirts.com

# Tracking — Meta (live)
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id
META_CAPI_ACCESS_TOKEN=your_meta_capi_access_token

# Tracking — OpenAI / ChatGPT Ads (PENDING — leave blank until provisioned;
# pixel + CAPI stay dark while these are unset)
NEXT_PUBLIC_OPENAI_PIXEL_ID=
OPENAI_ADS_API_KEY=

# --- Legacy: used only by the deprecated notify-new-lead edge function ---
# (the on_new_lead_created trigger is dropped in migration 006)
TWILIO_PHONE_NUMBER=+1234567890
OWNER_PHONE_NUMBER=+1234567890
